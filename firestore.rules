rules_version = '2';

// ============================================================================
// NovaCart — Firestore Security Rules
// ============================================================================
// Deploy with: firebase deploy --only firestore:rules
// (requires a Firebase project + the Firebase CLI logged in and linked via
// `firebase use --add`).
//
// Design principle used throughout: every piece of user data lives under
// `users/{userId}/...`, and the single rule at the bottom of that block —
// "you may only read/write your own subtree" — covers wishlist, cart,
// addresses, orders, notifications, and recentlyViewed all at once, instead
// of repeating the same ownership check nine times. Collections that don't
// fit that shape (products, banners, feedback) get their own explicit rules.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // users/{userId} — profile doc, plus every per-user subcollection
    // (wishlist, cart, savedForLater, addresses, orders, notifications,
    // recentlyViewed). A user can only ever read or write their own data;
    // no other authenticated user — and no unauthenticated request — can
    // read someone else's orders, addresses, wishlist, etc.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      // Account creation happens via AuthRemoteDataSource right after
      // Firebase Auth signUp — allow the newly-authenticated user to
      // create their own profile doc, but never anyone else's.
      allow create: if isOwner(userId);
      allow delete: if false; // account deletion is a deliberate, separate flow

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------------
    // products — public catalog, read-only from the client. Writes only
    // happen from a trusted context (Firebase Console, an admin tool, or
    // a Cloud Function with the Admin SDK, which bypasses these rules
    // entirely) — never directly from the app.
    // ------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // banners — same reasoning as products: public, read-only, managed
    // out-of-band.
    // ------------------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // feedback — write-only from the client (FeedbackService.submit()
    // never reads anything back), and nobody can read it back through
    // the client at all — feedback is meant to be reviewed from the
    // Firebase Console / an internal admin tool, not by other users or
    // even the submitting user themselves through the app.
    // ------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
